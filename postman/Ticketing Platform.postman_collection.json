{
	"info": {
		"_postman_id": "876ef120-6673-4cb8-9c9f-9e250c2ec53e",
		"name": "Ticketing Platform",
		"description": "Main flows of the ticketing platform. Run the folders in order: each request stores the ids it creates in collection variables (eventId, orderId) so the next ones can use them.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "19607651"
	},
	"item": [
		{
			"name": "1. Events",
			"item": [
				{
					"name": "Create event",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.collectionVariables.set(\"eventId\", pm.response.json().eventId);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Api-Key",
								"value": "{{adminApiKey}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Rock Fest\",\n  \"date\": \"2099-01-01T20:00:00Z\",\n  \"venue\": \"Movistar Arena\",\n  \"capacity\": 10\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/events",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events"
							]
						},
						"description": "Administrative endpoint: requires the X-Api-Key header."
					},
					"response": []
				},
				{
					"name": "List events",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/events",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get event",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/events/{{eventId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events",
								"{{eventId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get availability",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/events/{{eventId}}/availability",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events",
								"{{eventId}}",
								"availability"
							]
						},
						"description": "Real-time counters per ticket state, read with strong consistency."
					},
					"response": []
				},
				{
					"name": "Stream availability (SSE)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "text/event-stream"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/events/{{eventId}}/availability/stream",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events",
								"{{eventId}}",
								"availability",
								"stream"
							]
						},
						"description": "Server-Sent Events: the connection stays open and pushes the counters every time they change. Easier to watch with: curl -N {{baseUrl}}/events/{{eventId}}/availability/stream"
					},
					"response": []
				},
				{
					"name": "Assign complimentary tickets",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Api-Key",
								"value": "{{adminApiKey}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/events/{{eventId}}/complimentary",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"events",
								"{{eventId}}",
								"complimentary"
							]
						},
						"description": "Moves tickets from AVAILABLE to COMPLIMENTARY (final, not accountable)."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Purchase flow",
			"item": [
				{
					"name": "Place order",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.collectionVariables.set(\"orderId\", pm.response.json().orderId);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "{{idempotencyKey}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"customerId\": \"customer-1\",\n  \"quantity\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders"
							]
						},
						"description": "Queues the purchase and answers 202 with the order id. Inventory is not touched yet."
					},
					"response": []
				},
				{
					"name": "Get order status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders",
								"{{orderId}}"
							]
						},
						"description": "The consumer processes the order asynchronously. If it still says PENDING, send it again."
					},
					"response": []
				},
				{
					"name": "Confirm order",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status is 200', () => pm.response.to.have.status(200));",
									"pm.test('order is sold', () => pm.expect(pm.response.json().orderStatus).to.eql('SOLD'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}/confirm",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders",
								"{{orderId}}",
								"confirm"
							]
						},
						"description": "Charges the order (simulated payment). RESERVED -> PENDING_CONFIRMATION -> SOLD."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api/v1"
		},
		{
			"key": "adminApiKey",
			"value": "local-admin-key"
		},
		{
			"key": "eventId",
			"value": ""
		},
		{
			"key": "orderId",
			"value": ""
		},
		{
			"key": "idempotencyKey",
			"value": ""
		}
	]
}